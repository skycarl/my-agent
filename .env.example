# Version / Build Info (set automatically during deployment)
# GIT_COMMIT=abc1234...
# GIT_COMMIT_MESSAGE=your commit message

# Authentication (required — all mutating endpoints reject requests until this is set)
# Generate a random secret, e.g.: openssl rand -hex 32
X_TOKEN=

# OpenAI Configuration
# Set your OpenAI API key here (leave empty if not using OpenAI services)
OPENAI_API_KEY= 
# Default OpenAI model to use for agents (defaults to gpt-5.6-terra)
DEFAULT_MODEL=gpt-5.6-terra
# Reasoning effort for agents with no override below (defaults to high)
# DEFAULT_REASONING_EFFORT=high
# Per-agent reasoning effort overrides (JSON dict, valid values: none, low, medium, high, xhigh, max)
# AGENT_REASONING_EFFORT={"commute":"medium","scheduler":"medium","alert_processor":"medium"}
# OpenAI API timeout in seconds (defaults to 30)
OPENAI_TIMEOUT=30
# Maximum number of retries for OpenAI API calls (defaults to 3)
OPENAI_MAX_RETRIES=3

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# URL of the FastAPI app (for bot to communicate with API)
# For local development (outside Docker):
APP_URL=http://localhost:8000
# For Docker Compose deployment (app listens on 8001 in docker-compose.yml):
# APP_URL=http://app:8001

# Your Telegram user ID (the owner). The owner can always use the bot, manages the
# authorized-user/group allowlist via /adduser, /removeuser, /allowgroup, and is the
# default target for system messages (alerts, errors). Additional users and groups are
# added at runtime and persisted to storage/authorized_users.json.
# To find your user ID, message @userinfobot on Telegram
# Or use @raw_data_bot and look for "from":{"id":YOUR_USER_ID}
OWNER_USER_ID=
# Maximum number of messages to keep in conversation history (defaults to 50)
MAX_CONVERSATION_HISTORY=50

# Garden Database Configuration
# Path to the garden database JSON file
# For local development (outside Docker):
GARDEN_DB_PATH=storage/garden_db.json
# For Docker Compose deployment:
# GARDEN_DB_PATH=/app/workspace/storage/garden_db.json

# Logging Configuration
# Set the logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Use DEBUG for development, INFO for production
LOG_LEVEL=INFO

# Email Sink Configuration
# Enable email sink monitoring service (defaults to false)
EMAIL_SINK_ENABLED=false
# Gmail address for email monitoring (leave empty if not using email sink)
EMAIL_ADDRESS=
# Gmail app password for email monitoring (generate from Google account settings)
# Visit: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=
# IMAP server for email monitoring (defaults to imap.gmail.com for Gmail)
EMAIL_IMAP_SERVER=imap.gmail.com
# Email polling interval in seconds (defaults to 60)
EMAIL_POLL_INTERVAL=60
# Comma-separated list of sender patterns to monitor (supports substrings)
# Examples: "alerts@" or "alerts@transit.gov,@weatherservice.gov,notifications@"
EMAIL_SENDER_PATTERNS=alerts@
# Storage directory path for persistent data
# For local development (outside Docker):
STORAGE_PATH=storage
# For Docker Compose deployment:
# STORAGE_PATH=/app/workspace/storage

# Strava Configuration
# Create an API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Get a refresh token via OAuth2 authorization flow
STRAVA_REFRESH_TOKEN=

# Timezone Configuration
# Application timezone used for all local timestamps (defaults to America/Los_Angeles)
# Examples: "UTC", "America/New_York", "Europe/London", "America/Los_Angeles"
TIMEZONE=America/Los_Angeles

# Task Scheduler Configuration
# Enable or disable the task scheduler service (defaults to true)
SCHEDULER_ENABLED=true
# Timezone for scheduled tasks (defaults to America/Los_Angeles)
# Examples: "UTC", "America/New_York", "Europe/London", "America/Los_Angeles"
SCHEDULER_TIMEZONE=America/Los_Angeles
# Interval in seconds to check for task config changes (defaults to 30)
TASK_CONFIG_RELOAD_INTERVAL=30
# Cleanup strategy after a one-time task runs: 'remove' or 'disable' (defaults to remove)
# ONE_TIME_TASK_CLEANUP_MODE=remove
# Run a missed one-time task on startup if within this many seconds (defaults to 3600)
# ONE_TIME_TASK_MISFIRE_GRACE_SECONDS=3600
# Note: Task config and results files are automatically located in the storage directory:
#   - Task config: {STORAGE_PATH}/scheduled_tasks.json
#   - Task results: {STORAGE_PATH}/task_results.json